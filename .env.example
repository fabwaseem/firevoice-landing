# Postgres (on Coolify: the internal URL of the FireVoice Postgres service)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/firevoice"
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=""
# the admin dashboard's password (/admin): long and random
ADMIN_PASSWORD=""
# licences are built but off while FireVoice is free for everyone
LICENSING_ENABLED="false"
# optional: verification and password-reset mail. Without it, accounts work and mail is skipped.
SMTP_URL="smtps://USER:PASSWORD@smtp.example.com:465"
MAIL_FROM="FireVoice <hello@firevoice.fabwaseem.com>"
NEXT_PUBLIC_SITE_URL="https://firevoice.fabwaseem.com"
